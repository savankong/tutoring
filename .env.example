# Copy to .env for local dev (server/index.js and Vite both read process.env;
# use `export $(cat .env | xargs)` or a tool like dotenv-cli to load it).
# In production these are set in the DO App Platform dashboard as SECRET
# env vars — see .do/app.yaml and CLAUDE.md's Hosting section.

# DO Managed PostgreSQL connection string (postgres://user:pass@host:port/db).
DATABASE_URL=

# Session signing.
JWT_SECRET=

# Stripe (live mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=
# One-time capture passes, added 2026-08-30 — see netlify/lib/plans.js's
# PASSES export. Each must be a one-time Price (not recurring) in Stripe.
STRIPE_PRICE_PASS_24H=
STRIPE_PRICE_PASS_7D=
STRIPE_PRICE_PASS_30D=

# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (password reset / verification / form-submission emails).
RESEND_API_KEY=
# Resend Audience ID new users are synced into on signup (see
# netlify/lib/email.js's addContactToAudience) — create the Audience in the
# Resend dashboard first, then paste its ID here. Optional: signup still
# works fine without it, users just won't be added to the audience until
# it's set (and existing users need scripts/backfill-resend-audience.mjs).
# Composing/sending update emails to this audience happens entirely in the
# Resend dashboard's Broadcasts feature, not in this codebase.
RESEND_AUDIENCE_ID=

# Read implicitly by the @anthropic-ai/sdk default constructor
# (analyze-question.js). On Netlify this was never an explicitly-set env
# var (see CLAUDE.md) — on DO it MUST be set explicitly or every capture
# fails outright.
ANTHROPIC_API_KEY=

# System 02 of the Cambo Autopilot plan (wiki "Automation Plan — Cambo
# Autopilot") — scripts/metrics/*.mjs, run nightly/weekly by
# .github/workflows/metrics-*.yml as GitHub Actions repo secrets, not DO
# App Platform env vars (these scripts don't run in the deployed app).
# Plausible Stats API — requires a Plausible Business plan. Create the key
# under Settings -> API Keys in the Plausible dashboard.
PLAUSIBLE_API_KEY=
# Defaults to camboapp.com in code; only set this if the Plausible site ID differs.
PLAUSIBLE_SITE_ID=
# Anthropic Admin API key (sk-ant-admin...) for the Cost Report API —
# deliberately NOT the same as ANTHROPIC_API_KEY above, which the cost/usage
# endpoints reject. Created in the Claude Console by an org admin.
ANTHROPIC_ADMIN_KEY=
