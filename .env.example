# Copy to .env for local dev (server/index.js and Vite both read process.env;
# use `export $(cat .env | xargs)` or a tool like dotenv-cli to load it).
# In production these are set in the DO App Platform dashboard as SECRET
# env vars — see .do/app.yaml and CLAUDE.md's Hosting section.

# DO Managed PostgreSQL connection string (postgres://user:pass@host:port/db).
DATABASE_URL=

# Session signing.
JWT_SECRET=

# Stripe (live mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=

# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (password reset / verification / form-submission emails).
RESEND_API_KEY=

# Read implicitly by the @anthropic-ai/sdk default constructor
# (analyze-question.js). On Netlify this was never an explicitly-set env
# var (see CLAUDE.md) — on DO it MUST be set explicitly or every capture
# fails once the free OpenRouter fallback below also misses.
ANTHROPIC_API_KEY=

# Optional: free-tier model tried before falling back to Claude.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
